@page "/checkout"
@using Fluxor
@using Day07Demo.Guards
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IState<CartState> CartState
@inject IDispatcher Dispatcher
@inject NavigationManager Navigation

<h3>Checkout</h3>

<table class="table">
    <thead>
        <tr>
            <th>Item</th>
            <th>Price</th>
            <th>Qty</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in CartState.Value.Items)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Price.ToString("C")</td>
                <td>@item.Quantity</td>
                <td>
                    <button class="btn btn-sm btn-danger"
                            @onclick="() => Remove(item.Name)">
                        Remove
                    </button>
                </td>
            </tr>
        }
    </tbody>
</table>

<p><strong>Total:</strong> @CartState.Value.Items.Sum(i => i.Price * i.Quantity).ToString("C")</p>

@code {
    // ROUTE GUARD — today's whole lesson. A guard is access-control logic that runs in
    // OnInitialized, the lifecycle hook that fires BEFORE the first render. Putting the
    // check here (not OnAfterRender) means an unauthorized visitor is rerouted before any
    // HTML ships — no ~50ms flash of an empty checkout the user watches disappear.
    // Three ingredients, all already known: IState<T> (read the store) + a condition +
    // NavigationManager.NavigateTo (reroute). The guard IS the combination — neither API
    // alone does access control (a <NavLink> runs no logic; reading state reroutes no one).
    protected override void OnInitialized()
    {
        base.OnInitialized();

        // The decision lives in CartGuard (a plain static class), not inline here, so it
        // can be unit-tested without rendering the component or the renderer.
        if (CartGuard.ShouldRedirect(CartState.Value))
        {
            // return AFTER NavigateTo is critical: NavigateTo schedules the reroute but does
            // NOT stop this method. The router is about to abandon this component, so any code
            // below would run against a page being torn down. Guard → redirect → return.
            Navigation.NavigateTo("/shop");
            return;
        }
    }

    private void Remove(string itemName)
    {
        Dispatcher.Dispatch(new RemoveFromCartAction(itemName));
    }
}
