<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <HeadOutlet @rendermode="RenderMode.InteractiveServer" />
</head>

<body>
    @* StoreInitializer boots the Fluxor store. WITHOUT it the store never initializes, no
       action ever reaches a reducer, and every slice sits frozen at initial state — a clean
       build that silently does nothing. The guard would then ALWAYS see an empty cart and
       redirect every visitor. It needs its OWN @rendermode because it renders OUTSIDE
       <Routes> (which carries its own below). *@
    <Fluxor.Blazor.Web.StoreInitializer @rendermode="RenderMode.InteractiveServer" />
    <Routes @rendermode="RenderMode.InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
