@page "/shop"
@using Fluxor
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IState<CartState> CartState
@inject IDispatcher Dispatcher

<h3>Shop</h3>

<div class="row">
    @foreach (var product in _products)
    {
        <div class="col-md-4 mb-3">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">@product.Name</h5>
                    <p class="card-text">@product.Price.ToString("C")</p>
                    <button class="btn btn-primary"
                            @onclick="() => AddToCart(product)">
                        Add to Cart
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<div class="mt-3">
    <p>Cart items: <strong>@CartState.Value.Items.Count</strong></p>
    <a href="/checkout" class="btn btn-success">Go to Checkout</a>
</div>

@code {
    private readonly List<CartItem> _products =
    [
        new("Laptop", 999.99m, 1),
        new("Mouse", 29.99m, 1),
        new("Keyboard", 79.99m, 1)
    ];

    private void AddToCart(CartItem product)
    {
        Dispatcher.Dispatch(new AddToCartAction(product));
    }
}
