@page "/form/step2"
@using Fluxor
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IState<FormState> FormState
@inject IDispatcher Dispatcher
@inject NavigationManager Navigation

<h3>Form Wizard -- Step 2 of 3</h3>

@* ============================================================ *@
@* PRACTICE 3 (take-home stretch): Add a route guard here.                  *@
@*                                                               *@
@* TODO: Override OnInitialized                                  *@
@* TODO: Check if FormState.Value.CompletedSteps contains step 1 *@
@* TODO: If step 1 is not completed, redirect to "/form/step1"  *@
@* ============================================================ *@

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Contact Details</h5>

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" placeholder="Enter your email" />
        </div>

        <button class="btn btn-primary" @onclick="CompleteAndNext">
            Next: Step 3
        </button>
    </div>
</div>

<div class="mt-3 text-muted">
    Completed steps: @string.Join(", ", FormState.Value.CompletedSteps.Order())
</div>

@code {
    private void CompleteAndNext()
    {
        Dispatcher.Dispatch(new CompleteStepAction(2));
        Navigation.NavigateTo("/form/step3");
    }
}
