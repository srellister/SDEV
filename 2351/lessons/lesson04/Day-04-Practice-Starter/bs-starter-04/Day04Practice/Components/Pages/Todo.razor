@page "/todo"
@inherits FluxorComponent
@inject IState<Day04Practice.Features.Todo.Store.TodoState> TodoState
@inject IDispatcher Dispatcher
@* TODO: Add @inherits FluxorComponent *@
@* TODO: Add @inject IState<Day04Practice.Features.Todo.Store.TodoState> TodoState *@
@* TODO: Add @inject IDispatcher Dispatcher *@

<PageTitle>Practice 2: Todo List</PageTitle>

<h1>Practice 2: Todo List</h1>

<div class="card mb-3">
    <div class="card-body">
        <div class="input-group">
            <input type="text" class="form-control" placeholder="Enter a new todo..."
                   @bind="newTodoTitle" @bind:event="oninput"
                   @onkeydown="HandleKeyDown" />
            <button class="btn btn-primary" @onclick="AddTodo" disabled="@string.IsNullOrWhiteSpace(newTodoTitle)">
                Add Todo
            </button>
        </div>
    </div>
</div>

@* TODO: Replace the placeholder below with Fluxor state, and show an empty-state message when the list is empty (same @if pattern as Counter in Practice 1) *@
@* Use: TodoState.Value.Items *@

@if (TodoState.Value.Items.Count == 0) {
<div class="alert alert-warning role="alert">
    Warning: Your To-Do list is empty!
</div>
}


@* When wired, render the todo list like this: *@

<ul class="list-group">
    @foreach (var item in TodoState.Value.Items)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <div>
                <input type="checkbox" class="form-check-input me-2"
                       checked="@item.IsComplete"
                       @onchange="() => ToggleTodo(item.Id)" />
                <span style="@(item.IsComplete ? "text-decoration: line-through; opacity: 0.6;" : "")">
                    @item.Title
                </span>
            </div>
            <button class="btn btn-sm btn-outline-danger" @onclick="() => RemoveTodo(item.Id)">
                Remove
            </button>
        </li>
    }
</ul>


@code {
    private string newTodoTitle = string.Empty;

    private void AddTodo()
    {
        if (!string.IsNullOrWhiteSpace(newTodoTitle))
        {
            // TODO: Dispatcher.Dispatch(new AddTodoAction(newTodoTitle));
            Dispatcher.Dispatch(action: new Day04Practice.Features.Todo.Store.AddTodoAction(newTodoTitle));
            newTodoTitle = string.Empty;
        }
    }

    private void RemoveTodo(int id)
    {
        // TODO: Dispatcher.Dispatch(new RemoveTodoAction(id));
        Dispatcher.Dispatch(action: new Day04Practice.Features.Todo.Store.RemoveTodoAction(id));

    }

    private void ToggleTodo(int id)
    {
        // TODO: Dispatcher.Dispatch(new ToggleTodoAction(id));
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            AddTodo();
        }
    }
}
